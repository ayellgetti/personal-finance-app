# Copy to .env.prod on the EC2 host. Do not commit .env.prod.
# PUBLIC_ORIGIN must match the URL in the browser (no trailing slash).
# Example: http://13.201.12.34  or  https://myfinancefreedom.com

PUBLIC_ORIGIN=http://REPLACE_WITH_EC2_PUBLIC_IP

# Host port nginx publishes. Keep 80 unless a TLS terminator fronts the stack.
PUBLIC_PORT=80
TLS_PORT=443

# Let's Encrypt (leave TLS_DOMAIN empty for HTTP-only / IP access).
# Point both DNS names at this host, open security-group 80 and 443, then set:
# TLS_DOMAIN=myfinancefreedom.com
# TLS_WWW_DOMAIN=www.myfinancefreedom.com
# CERTBOT_EMAIL=you@example.com
# PUBLIC_ORIGIN=https://myfinancefreedom.com
TLS_DOMAIN=
TLS_WWW_DOMAIN=
CERTBOT_EMAIL=

POSTGRES_USER=finance
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=finance

JWT_ACCESS_SECRET=replace-with-at-least-16-chars
JWT_REFRESH_SECRET=replace-with-a-different-16-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_SECONDS=604800
BCRYPT_ROUNDS=10

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_TIMEOUT_MS=90000

ADVISOR_ALLOW_REFRESH=false

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
SMS_DEFAULT_COUNTRY_CODE=+91

UPLOAD_DIR=uploads
UPLOAD_MAX_FILE_SIZE_BYTES=5242880
