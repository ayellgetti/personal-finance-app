# Local Compose template. Copy to .env.dev (gitignored if you add it) or pass
# as env_file. Do not put real passwords, App Passwords, or API keys here.
#
#   cp .env.example .env.dev
#
# Host-side API (`pnpm --filter api`) still uses apps/api/.env — see
# apps/api/.env.example. Compose DNS names (postgres, redis) will not resolve
# outside the Docker network.

# API
# The api image defaults NODE_ENV=production. This file is passed as env_file
# and must override it for local compose, or OTP email/SMS failures become 502.
NODE_ENV=development
PORT=5001
CORS_ORIGIN=http://web.local.uat
BCRYPT_ROUNDS=10

# PostgreSQL credentials (interpolated by docker-compose.yml)
POSTGRES_USER=example
POSTGRES_PASSWORD=example
POSTGRES_DB=example
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin

# PostgreSQL — Compose DNS (host-side API uses apps/api/.env)
DATABASE_URL=postgresql://example:example@postgres:5432/example

# Redis credentials (interpolated by docker-compose.yml for Redis Insight)
REDIS_HOST=redis
REDIS_PORT=6379

# JWT — replace these before deploying
JWT_ACCESS_SECRET=dev-only-access-secret
JWT_REFRESH_SECRET=dev-only-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_SECONDS=604800

# OpenAI — optional; the planner works without it
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_TIMEOUT_MS=90000

# Redis — advisor report cache (Compose service name, not localhost)
REDIS_URL=redis://redis:6379

# Advisor — true lets ?refresh=1 overwrite the saved report. Every generation
# still spends one unit of that user's User.aiReportLimit (default 1). Grant
# extra reports by incrementing aiReportLimit on that user row, not via env.
ADVISOR_ALLOW_REFRESH=true

# Development only. true lifts the per-user allowance: generations are not
# counted and 402 AI_REPORT_LIMIT_REACHED is never raised.
# Ignored whenever NODE_ENV=production.
ADVISOR_IGNORE_QUOTA=false

# Uploads — local disk staging (replace storage provider for S3)
UPLOAD_DIR=uploads
UPLOAD_MAX_FILE_SIZE_BYTES=5242880

# OTP delivery — registration codes are emailed and texted. Leave SMTP_* blank
# to log the send and return the OTP in the API response (NODE_ENV=development).
# Gmail: use a 16-character App Password (Google Account → Security →
# 2-Step Verification → App passwords). The normal Gmail password is rejected
# with 535 BadCredentials. Do not wrap the value in quotes. Write $ as $$ if
# Docker Compose interpolates the file.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
SMS_DEFAULT_COUNTRY_CODE=+91

# Web (Vite) — optional; docker-compose.yml does not pass these today.
# Use if you bind-mount the web app and need custom hosts or API proxy.
# VITE_DEV_ALLOWED_HOSTS=web.local.uat
# VITE_DEV_POLLING=true
# VITE_API_PROXY=http://api:5001
