# PostgreSQL
DATABASE_URL=postgresql://example:example@localhost:5433/example

# API
PORT=5001
CORS_ORIGIN=http://localhost:5173
BCRYPT_ROUNDS=10

# JWT — replace these before deploying
JWT_ACCESS_SECRET=dev-only-access-secret
JWT_REFRESH_SECRET=dev-only-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_SECONDS=604800

# OpenAI — optional; the planner works without it
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_TIMEOUT_MS=90000

# Redis — advisor report cache
REDIS_URL=redis://localhost:6379
