# PostgreSQL
DATABASE_URL=postgresql://example:example@localhost:5433/example

# API
PORT=5001
CORS_ORIGIN=http://localhost:5173
BCRYPT_ROUNDS=10

# JWT — replace these before deploying
JWT_ACCESS_SECRET=dev-only-access-secret
JWT_REFRESH_SECRET=dev-only-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_SECONDS=604800

# OpenAI — optional; the planner works without it
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_TIMEOUT_MS=90000

# Redis — advisor report cache
REDIS_URL=redis://localhost:6379

# Advisor — omit (or false) to reuse the cached OpenAI report. Set true to allow refresh/regenerate.
# ADVISOR_ALLOW_REFRESH=

# Advisor — development only. Set true to lift the per-user AI report allowance:
# refreshes stop being counted and 402 AI_REPORT_LIMIT_REACHED is never raised.
# Ignored whenever NODE_ENV=production.
ADVISOR_IGNORE_QUOTA=false

# Uploads — local disk staging (replace storage provider for S3)
UPLOAD_DIR=uploads
UPLOAD_MAX_FILE_SIZE_BYTES=5242880
ADVISOR_ALLOW_REFRESH=false

# OTP delivery — registration codes are emailed and texted. Leave blank in local
# development to log the send and return the OTP in the API response.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
SMS_DEFAULT_COUNTRY_CODE=+91