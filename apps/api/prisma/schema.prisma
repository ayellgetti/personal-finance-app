generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String   @id @default(uuid())
  firstName         String
  lastName          String
  dob               DateTime
  gender            String
  countryCode       String   @default("+91")
  mobileNo          String   @unique
  email             String   @unique
  password          String
  oldPasswords      String[] @default([])
  avatar            String?
  avatarBackground  String?
  entryData         Json?
  quickStep         Int      @default(0)
  aiReportCount     Int      @default(0)
  aiReportLimit     Int      @default(1)
  isActive          Int      @default(1)
  createdBy         String?
  createdAt         DateTime @default(now())
  updatedBy         String?
  updatedAt         DateTime @updatedAt
  deletedBy         String?
  deletedAt         DateTime?

  refreshSessions            RefreshSession[]
  failureLogs                FailureLog[]
  sessions                   Session[]
  contacts                   Contact[]
  budgets                    Budget[]
  planners                   Planner[]
  loans                      Loan[]
  investments                Investment[]
  insurances                 Insurance[]
  goals                      Goal[]
  financialProfile           FinancialProfile?
  transactions               Transaction[]
  devices                    Device[]
  sockets                    Socket[]
  notifications              Notification[]
  conversationMembers        ConversationMember[]
  conversationMessages       ConversationMessage[]
  conversationMessageStatus  ConversationMessageStatus[]
  statementImports           StatementImport[]
  statementLines             StatementLine[]
  taxScenarios               TaxScenario[]
  calculatorScenarios        CalculatorScenario[]
  userRoles                  UserRole[]
  assignedCrmEnquiries       CrmEnquiry[]       @relation("CrmEnquiryAssignedTo")
  assignedCrmFollowUps       CrmFollowUp[]      @relation("CrmFollowUpAssignedTo")
  assignedCrmTasks           CrmTask[]          @relation("CrmTaskAssignee")
  assignedCrmCalendarEvents  CrmCalendarEvent[] @relation("CrmCalendarEventAssignee")
}

model FinancialProfile {
  id             String   @id @default(uuid())
  userId         String   @unique
  retirementAge  Int      @default(60)
  dependents     Int      @default(0)
  inflationRate  Float    @default(6)
  employmentType String   @default("Salaried")
  currency       String   @default("₹")
  isActive       Int      @default(1)
  createdBy      String?
  createdAt      DateTime @default(now())
  updatedBy      String?
  updatedAt      DateTime @updatedAt
  deletedBy      String?
  deletedAt      DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RefreshSession {
  jti       String    @id
  userId    String
  tokenHash String
  expiresAt DateTime
  isActive  Int       @default(1)
  createdBy String?
  createdAt DateTime  @default(now())
  updatedBy String?
  updatedAt DateTime  @updatedAt
  deletedBy String?
  deletedAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model FailureLog {
  id         String    @id @default(uuid())
  requestId  String
  method     String
  path       String
  statusCode Int
  message    String
  stack      String?
  details    Json?
  body       Json?
  userId     String?
  isActive   Int       @default(1)
  createdBy  String?
  createdAt  DateTime  @default(now())
  updatedBy  String?
  updatedAt  DateTime  @updatedAt
  deletedBy  String?
  deletedAt  DateTime?
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([requestId])
  @@index([createdAt])
  @@index([userId])
}

model Session {
  id        String    @id @default(uuid())
  userId    String
  valid     Boolean   @default(true)
  userAgent String?
  isActive  Int       @default(1)
  createdBy String?
  createdAt DateTime  @default(now())
  updatedBy String?
  updatedAt DateTime  @updatedAt
  deletedBy String?
  deletedAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Otp {
  id        String    @id @default(uuid())
  mobileNo  String
  no        Int
  type      String
  try       Int       @default(0)
  isActive  Int       @default(1)
  createdBy String?
  createdAt DateTime  @default(now())
  updatedBy String?
  updatedAt DateTime  @updatedAt
  deletedBy String?
  deletedAt DateTime?

  @@index([mobileNo, type])
}

// Chat-shaped stub. Unused. Do not reuse for Sales CRM — parties are CrmContact.
model Contact {
  id               String    @id @default(uuid())
  userId           String
  conversationId   String?
  firstName        String
  lastName         String?
  dob              DateTime?
  gender           String?
  mobileNo         String
  email            String?
  avatar           String?
  avatarBackground String?
  isActive         Int       @default(1)
  createdBy        String?
  createdAt        DateTime  @default(now())
  updatedBy        String?
  updatedAt        DateTime  @updatedAt
  deletedBy        String?
  deletedAt        DateTime?

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([mobileNo])
  @@index([conversationId])
}

model Constant {
  id        String    @id @default(uuid())
  column    String?
  code      String?
  value     String?
  desc      String?
  isActive  Int       @default(1)
  createdBy String?
  createdAt DateTime  @default(now())
  updatedBy String?
  updatedAt DateTime  @updatedAt
  deletedBy String?
  deletedAt DateTime?

  @@index([column])
  @@index([code])
}

model Categories {
  id          String   @id @default(uuid())
  parentCode  String?
  code        String   @unique
  title       String
  description String
  icon        String
  color       String
  isActive    Int       @default(1)
  createdBy   String?
  createdAt   DateTime  @default(now())
  updatedBy   String?
  updatedAt   DateTime  @updatedAt
  deletedBy   String?
  deletedAt   DateTime?

  parent        Categories?  @relation("CategoryTree", fields: [parentCode], references: [code], onDelete: SetNull)
  subcategories Categories[] @relation("CategoryTree")

  @@index([parentCode])
}

model Budget {
  id          String    @id @default(uuid())
  userId      String
  type        String
  category    String
  subcategory String
  title       String
  description String?
  amount      Float
  monthDay    Int?
  weekDay     Int?
  repeatCount Int?
  isActive    Int       @default(1)
  createdBy   String?
  createdAt   DateTime  @default(now())
  updatedBy   String?
  updatedAt   DateTime  @updatedAt
  deletedBy   String?
  deletedAt   DateTime?

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  planners Planner[]

  @@index([userId])
}

model Loan {
  id                     String    @id @default(uuid())
  userId                 String
  title                  String?
  type                   String
  principalPendingAmount Float
  roi                    Float
  remainingMonths        Int
  emiAmount              Float
  emiDay                 Int
  isActive               Int       @default(1)
  createdBy              String?
  createdAt              DateTime  @default(now())
  updatedBy              String?
  updatedAt              DateTime  @updatedAt
  deletedBy              String?
  deletedAt              DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Investment {
  id                 String    @id @default(uuid())
  userId             String
  category           String
  subcategory        String
  title              String?
  accumulatedAmount  Float
  roi                Float
  remainingMonths    Int
  investmentAmount   Float
  monthDay           Int
  onHold             Int       @default(0)
  isActive           Int       @default(1)
  createdBy          String?
  createdAt          DateTime  @default(now())
  updatedBy          String?
  updatedAt          DateTime  @updatedAt
  deletedBy          String?
  deletedAt          DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Insurance {
  id              String    @id @default(uuid())
  userId          String
  title           String?
  type            String
  coverageAmount  Float
  annualPremium   Float
  expiryDate      DateTime
  isActive        Int       @default(1)
  createdBy       String?
  createdAt       DateTime  @default(now())
  updatedBy       String?
  updatedAt       DateTime  @updatedAt
  deletedBy       String?
  deletedAt       DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Goal {
  id              String    @id @default(uuid())
  userId          String
  category        String
  subcategory     String
  title           String
  description     String?
  targetAmount    Float
  currentAmount   Float     @default(0)
  remainingYears  Int
  targetYear      Int
  bornYear        Int?
  currentAge      Int?
  targetAge       Int?
  isActive        Int       @default(1)
  createdBy       String?
  createdAt       DateTime  @default(now())
  updatedBy       String?
  updatedAt       DateTime  @updatedAt
  deletedBy       String?
  deletedAt       DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Planner {
  id              String    @id @default(uuid())
  userId          String
  budgetId        String
  type            String
  title           String
  description     String?
  principalAmount Float
  amount          Float
  rate            Float
  tenure          Int
  data            Json?
  isActive        Int       @default(1)
  createdBy       String?
  createdAt       DateTime  @default(now())
  updatedBy       String?
  updatedAt       DateTime  @updatedAt
  deletedBy       String?
  deletedAt       DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  budget Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([budgetId])
}

model Transaction {
  id          String   @id @default(uuid())
  userId      String
  title       String
  description String?
  data        Json
  isActive    Int       @default(1)
  createdBy   String?
  createdAt   DateTime  @default(now())
  updatedBy   String?
  updatedAt   DateTime  @updatedAt
  deletedBy   String?
  deletedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model StatementImport {
  id         String    @id @default(uuid())
  userId     String
  sourceType String
  fileName   String?
  periodFrom DateTime?
  periodTo   DateTime?
  currency   String    @default("INR")
  status     String
  summary    Json
  lineCount  Int       @default(0)
  isActive   Int       @default(1)
  createdBy  String?
  createdAt  DateTime  @default(now())
  updatedBy  String?
  updatedAt  DateTime  @updatedAt
  deletedBy  String?
  deletedAt  DateTime?

  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  lines StatementLine[]

  @@index([userId])
  @@index([userId, isActive])
}

model StatementLine {
  id          String    @id @default(uuid())
  userId      String
  importId    String
  postedOn    DateTime?
  description String
  amount      Float
  direction   String
  category    String
  merchant    String?
  raw         Json?
  isActive    Int       @default(1)
  createdBy   String?
  createdAt   DateTime  @default(now())
  updatedBy   String?
  updatedAt   DateTime  @updatedAt
  deletedBy   String?
  deletedAt   DateTime?

  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  statementImport StatementImport @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([importId])
  @@index([userId, category])
}

model TaxScenario {
  id             String    @id @default(uuid())
  userId         String
  countryCode    String
  regimeCode     String
  financialYear  String
  assessmentYear String
  title          String
  input          Json
  result         Json
  isActive       Int       @default(1)
  createdBy      String?
  createdAt      DateTime  @default(now())
  updatedBy      String?
  updatedAt      DateTime  @updatedAt
  deletedBy      String?
  deletedAt      DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isActive])
}

model CalculatorScenario {
  id        String    @id @default(uuid())
  userId    String
  type      String
  title     String
  input     Json
  result    Json
  isActive  Int       @default(1)
  createdBy String?
  createdAt DateTime  @default(now())
  updatedBy String?
  updatedAt DateTime  @updatedAt
  deletedBy String?
  deletedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isActive])
  @@index([userId, type, isActive])
}

model Device {
  id         String   @id @default(uuid())
  userId     String
  device     String
  deviceType String
  os         String?
  version    String?
  token      String?
  data       Json
  isActive   Int       @default(1)
  createdBy  String?
  createdAt  DateTime  @default(now())
  updatedBy  String?
  updatedAt  DateTime  @updatedAt
  deletedBy  String?
  deletedAt  DateTime?

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sockets Socket[]

  @@index([userId])
}

model Socket {
  id        String   @id @default(uuid())
  userId    String
  socketId  String
  deviceId  String?
  isActive  Int       @default(1)
  createdBy String?
  createdAt DateTime  @default(now())
  updatedBy String?
  updatedAt DateTime  @updatedAt
  deletedBy String?
  deletedAt DateTime?

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  device Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([socketId])
  @@index([deviceId])
}

model Notification {
  id          String    @id @default(uuid())
  title       String
  description String
  recipientId String
  read        Int       @default(0)
  isActive    Int       @default(1)
  createdBy   String?
  createdAt   DateTime  @default(now())
  updatedBy   String?
  updatedAt   DateTime  @updatedAt
  deletedBy   String?
  deletedAt   DateTime?

  recipient User @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId])
}

model Conversation {
  id        String    @id @default(uuid())
  type      String
  name      String?
  isActive  Int       @default(1)
  createdBy String?
  createdAt DateTime  @default(now())
  updatedBy String?
  updatedAt DateTime  @updatedAt
  deletedBy String?
  deletedAt DateTime?

  members        ConversationMember[]
  messages       ConversationMessage[]
  messageStatus  ConversationMessageStatus[]
  contacts       Contact[]
}

model ConversationMember {
  id             String   @id @default(uuid())
  conversationId String
  userId         String
  isActive       Int       @default(1)
  createdBy      String?
  createdAt      DateTime  @default(now())
  updatedBy      String?
  updatedAt      DateTime  @updatedAt
  deletedBy      String?
  deletedAt      DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model ConversationMessage {
  id             String   @id @default(uuid())
  conversationId String
  userId         String
  type           String
  message        String
  isActive       Int       @default(1)
  createdBy      String?
  createdAt      DateTime  @default(now())
  updatedBy      String?
  updatedAt      DateTime  @updatedAt
  deletedBy      String?
  deletedAt      DateTime?

  conversation Conversation                @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  status       ConversationMessageStatus[]

  @@index([conversationId])
  @@index([userId])
}

model ConversationMessageStatus {
  id                    String   @id @default(uuid())
  conversationMessageId String
  conversationId        String
  userId                String
  type                  String
  isActive              Int       @default(1)
  createdBy             String?
  createdAt             DateTime  @default(now())
  updatedBy             String?
  updatedAt             DateTime  @updatedAt
  deletedBy             String?
  deletedAt             DateTime?

  message      ConversationMessage @relation(fields: [conversationMessageId], references: [id], onDelete: Cascade)
  conversation Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationMessageId, userId, type])
  @@index([conversationId])
  @@index([userId])
}

model Tradingview {
  id        String   @id @default(uuid())
  datetime  String?
  timestamp BigInt?
  timeframe String?
  orderId   BigInt?
  type      String?
  exchange  String?
  symbol    String?
  price     Float?
  volume    Float?
  isActive  Int       @default(1)
  createdBy String?
  createdAt DateTime  @default(now())
  updatedBy String?
  updatedAt DateTime  @updatedAt
  deletedBy String?
  deletedAt DateTime?

  @@index([symbol])
  @@index([timestamp])
}

enum CrmContactType {
  lead
  client
  vendor
  employee
}

enum CrmEnquiryStatus {
  new
  in_progress
  won
  lost
  on_hold
}

enum CrmFollowUpStatus {
  pending
  completed
  cancelled
}

enum CrmClientStatus {
  active
  inactive
}

enum CrmPaymentStatus {
  pending
  paid
  failed
  refunded
}

enum CrmTaskStatus {
  todo
  in_progress
  in_review
  done
}

model Role {
  id        String    @id @default(uuid())
  name      String    @unique
  slug      String    @unique
  isActive  Int       @default(1)
  createdBy String?
  createdAt DateTime  @default(now())
  updatedBy String?
  updatedAt DateTime  @updatedAt
  deletedBy String?
  deletedAt DateTime?

  rolePermissions RolePermission[]
  userRoles       UserRole[]
}

model Permission {
  id        String    @id @default(uuid())
  code      String    @unique
  name      String
  isActive  Int       @default(1)
  createdBy String?
  createdAt DateTime  @default(now())
  updatedBy String?
  updatedAt DateTime  @updatedAt
  deletedBy String?
  deletedAt DateTime?

  rolePermissions RolePermission[]
}

model RolePermission {
  id           String    @id @default(uuid())
  roleId       String
  permissionId String
  isActive     Int       @default(1)
  createdBy    String?
  createdAt    DateTime  @default(now())
  updatedBy    String?
  updatedAt    DateTime  @updatedAt
  deletedBy    String?
  deletedAt    DateTime?

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
}

model UserRole {
  id        String    @id @default(uuid())
  userId    String
  roleId    String
  isActive  Int       @default(1)
  createdBy String?
  createdAt DateTime  @default(now())
  updatedBy String?
  updatedAt DateTime  @updatedAt
  deletedBy String?
  deletedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([roleId])
}

model CrmContact {
  id          String         @id @default(uuid())
  name        String
  /// Unique among active rows (`isActive` = 1) via a partial unique index in SQL.
  mobile      String
  type        CrmContactType
  email       String?
  companyName String?
  notes       String?
  isActive    Int            @default(1)
  createdBy   String?
  createdAt   DateTime       @default(now())
  updatedBy   String?
  updatedAt   DateTime       @updatedAt
  deletedBy   String?
  deletedAt   DateTime?

  enquiries      CrmEnquiry[]
  followUps      CrmFollowUp[]
  client         CrmClient?
  tasks          CrmTask[]
  calendarEvents CrmCalendarEvent[]

  @@index([mobile])
  @@index([type])
}

model CrmEnquiry {
  id             String           @id @default(uuid())
  contactId      String
  title          String
  source         String
  status         CrmEnquiryStatus @default(new)
  expectedValue  Float?
  assignedToId   String?
  notes          String?
  isActive       Int              @default(1)
  createdBy      String?
  createdAt      DateTime         @default(now())
  updatedBy      String?
  updatedAt      DateTime         @updatedAt
  deletedBy      String?
  deletedAt      DateTime?

  contact         CrmContact          @relation(fields: [contactId], references: [id], onDelete: Restrict)
  assignedTo      User?               @relation("CrmEnquiryAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  followUps       CrmFollowUp[]
  convertedClient CrmClient?          @relation("CrmEnquiryConvertedClient")
  payments        CrmPayment[]
  tasks           CrmTask[]
  calendarEvents  CrmCalendarEvent[]

  @@index([status])
  @@index([contactId])
  @@index([assignedToId])
}

model CrmFollowUp {
  id           String            @id @default(uuid())
  enquiryId    String?
  contactId    String
  dueAt        DateTime
  status       CrmFollowUpStatus @default(pending)
  assignedToId String?
  notes        String?
  isActive     Int               @default(1)
  createdBy    String?
  createdAt    DateTime          @default(now())
  updatedBy    String?
  updatedAt    DateTime          @updatedAt
  deletedBy    String?
  deletedAt    DateTime?

  enquiry    CrmEnquiry? @relation(fields: [enquiryId], references: [id], onDelete: SetNull)
  contact    CrmContact  @relation(fields: [contactId], references: [id], onDelete: Restrict)
  assignedTo User?       @relation("CrmFollowUpAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([dueAt])
  @@index([status])
  @@index([assignedToId])
  @@index([contactId])
  @@index([enquiryId])
}

model CrmClient {
  id                      String          @id @default(uuid())
  contactId               String          @unique
  status                  CrmClientStatus @default(active)
  billingName             String
  gstin                   String?
  convertedFromEnquiryId  String?         @unique
  isActive                Int             @default(1)
  createdBy               String?
  createdAt               DateTime        @default(now())
  updatedBy               String?
  updatedAt               DateTime        @updatedAt
  deletedBy               String?
  deletedAt               DateTime?

  contact              CrmContact  @relation(fields: [contactId], references: [id], onDelete: Restrict)
  convertedFromEnquiry CrmEnquiry? @relation("CrmEnquiryConvertedClient", fields: [convertedFromEnquiryId], references: [id], onDelete: SetNull)
  payments             CrmPayment[]
}

model CrmPayment {
  id        String           @id @default(uuid())
  clientId  String
  enquiryId String?
  amount    Float
  currency  String           @default("INR")
  method    String
  status    CrmPaymentStatus @default(pending)
  paidAt    DateTime?
  reference String?
  isActive  Int              @default(1)
  createdBy String?
  createdAt DateTime         @default(now())
  updatedBy String?
  updatedAt DateTime         @updatedAt
  deletedBy String?
  deletedAt DateTime?

  client  CrmClient   @relation(fields: [clientId], references: [id], onDelete: Restrict)
  enquiry CrmEnquiry? @relation(fields: [enquiryId], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([status])
  @@index([paidAt])
  @@index([enquiryId])
}

model CrmTask {
  id          String        @id @default(uuid())
  title       String
  description String?
  status      CrmTaskStatus @default(todo)
  assigneeId  String?
  dueAt       DateTime?
  contactId   String?
  enquiryId   String?
  isActive    Int           @default(1)
  createdBy   String?
  createdAt   DateTime      @default(now())
  updatedBy   String?
  updatedAt   DateTime      @updatedAt
  deletedBy   String?
  deletedAt   DateTime?

  assignee User?       @relation("CrmTaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  contact  CrmContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  enquiry  CrmEnquiry? @relation(fields: [enquiryId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([assigneeId])
  @@index([dueAt])
  @@index([contactId])
  @@index([enquiryId])
}

model CrmCalendarEvent {
  id         String    @id @default(uuid())
  title      String
  startsAt   DateTime
  endsAt     DateTime
  contactId  String?
  enquiryId  String?
  assigneeId String?
  notes      String?
  isActive   Int       @default(1)
  createdBy  String?
  createdAt  DateTime  @default(now())
  updatedBy  String?
  updatedAt  DateTime  @updatedAt
  deletedBy  String?
  deletedAt  DateTime?

  contact  CrmContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  enquiry  CrmEnquiry? @relation(fields: [enquiryId], references: [id], onDelete: SetNull)
  assignee User?       @relation("CrmCalendarEventAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([startsAt])
  @@index([assigneeId])
  @@index([contactId])
  @@index([enquiryId])
}
