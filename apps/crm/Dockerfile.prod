FROM node:22-alpine AS build
ENV CI=true
RUN corepack enable && corepack prepare pnpm@11.9.0 --activate
WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
COPY apps/website/package.json apps/website/
COPY apps/crm/package.json apps/crm/
COPY packages/tsconfig/package.json packages/tsconfig/
RUN pnpm install --frozen-lockfile --filter crm...

COPY packages/tsconfig packages/tsconfig
COPY apps/crm apps/crm
WORKDIR /app/apps/crm
ARG VITE_OTP_AUTO_VERIFY=false
ENV VITE_OTP_AUTO_VERIFY=$VITE_OTP_AUTO_VERIFY
RUN pnpm build

FROM nginx:alpine AS runtime
COPY --from=build /app/apps/crm/dist /usr/share/nginx/html
COPY containers/nginx/nginx.crm.conf /etc/nginx/nginx.conf
COPY containers/crm/entrypoint.prod.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh && rm -f /etc/nginx/conf.d/default.conf && nginx -t
HEALTHCHECK --interval=10s --timeout=5s --retries=5 --start-period=10s \
  CMD wget -qO- http://127.0.0.1/ >/dev/null || exit 1
ENTRYPOINT ["/entrypoint.sh"]
