FROM node:22-alpine AS build
ENV CI=true
RUN corepack enable && corepack prepare pnpm@11.9.0 --activate
WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
COPY packages/tsconfig/package.json packages/tsconfig/
RUN pnpm install --frozen-lockfile --filter web...

COPY packages/tsconfig packages/tsconfig
COPY apps/web apps/web
WORKDIR /app/apps/web
RUN pnpm build

FROM nginx:1.27-alpine
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY deploy/nginx.conf /etc/nginx/conf.available/http.conf
COPY deploy/nginx.tls.conf /etc/nginx/conf.available/tls.conf
COPY deploy/snippets /etc/nginx/snippets
COPY deploy/docker-entrypoint.d/15-select-nginx-conf.sh /docker-entrypoint.d/15-select-nginx-conf.sh
COPY deploy/nginx-foreground.sh /nginx-foreground.sh
COPY --from=build /app/apps/web/dist /usr/share/nginx/html
RUN mkdir -p /var/www/certbot \
    && chmod +x /docker-entrypoint.d/15-select-nginx-conf.sh /nginx-foreground.sh \
    && nginx -t
EXPOSE 80 443
HEALTHCHECK --interval=10s --timeout=5s --retries=5 --start-period=10s \
  CMD wget -qO- http://127.0.0.1/health >/dev/null || exit 1
CMD ["/nginx-foreground.sh"]
