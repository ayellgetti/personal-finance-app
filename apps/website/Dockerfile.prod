FROM node:22-alpine AS build
ENV CI=true
RUN corepack enable && corepack prepare pnpm@11.9.0 --activate
WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
COPY apps/website/package.json apps/website/
COPY packages/tsconfig/package.json packages/tsconfig/
RUN pnpm install --frozen-lockfile --filter website...

COPY packages/tsconfig packages/tsconfig
COPY apps/website apps/website
WORKDIR /app/apps/website
ARG VITE_APP_URL=http://localhost:8080
ENV VITE_APP_URL=$VITE_APP_URL
RUN pnpm build

FROM nginx:alpine AS runtime
COPY --from=build /app/apps/website/dist /usr/share/nginx/html
COPY containers/nginx/nginx.website.conf /etc/nginx/nginx.conf
RUN rm -f /etc/nginx/conf.d/default.conf && nginx -t
EXPOSE 80
HEALTHCHECK --interval=10s --timeout=5s --retries=5 --start-period=10s \
  CMD wget -qO- http://127.0.0.1/ >/dev/null || exit 1
CMD ["nginx", "-g", "daemon off;"]
